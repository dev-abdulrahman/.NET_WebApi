{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=Application.WebApi;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "JwtSettings": {
    "Issuer": "MyCompany.AuthServer",
    "Audience": "MyCompany.ApiClients",
    "SecretKey": "THIS_IS_A_VERY_LONG_SECURE_KEY_CHANGE_IT",
    "ExpiryMinutes": 60
  }
}
