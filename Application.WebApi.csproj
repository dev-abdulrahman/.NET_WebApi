<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

	<ItemGroup>
		<Compile Remove="Application.Api.Entities\**" />
		<EmbeddedResource Remove="Application.Api.Entities\**" />
		<None Remove="Application.Api.Entities\**" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="Application.Api.Services\**" />
		<Content Remove="Application.Api.Entities\**" />
		<Content Remove="Application.Api.Services\**" />
		<EmbeddedResource Remove="Application.Api.Services\**" />
		<None Remove="Application.Api.Services\**" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="Application.Api.Entities\Application.Api.Entities.csproj" />
	  <ProjectReference Include="Application.Api.Services\Application.Api.Services.csproj" />
	</ItemGroup>
	

</Project>
